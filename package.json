{
  "name": "scoutset",
  "version": "1.0.0",
  "description": "Scoutset is search engine data explorer",
  "private": true,
  "scripts": {
    "dev:view": "cd src/mainview && bunx vite --host",
    "build:view": "cd src/mainview && bunx vue-tsc --noEmit && bunx vite build",
    "dev": "bun run build:view && electrobun dev",
    "build": "bun run build:view && electrobun build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/royteusink/scoutset.git"
  },
  "keywords": [
    "elasticsearch",
    "searchengine",
    "explorer",
    "viewer",
    "scoutset"
  ],
  "author": "Roy Teusink",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/royteusink/scoutset/issues"
  },
  "homepage": "https://github.com/royteusink/scoutset#readme",
  "devDependencies": {
    "@types/uuid": "^8.3.4",
    "@vitejs/plugin-vue": "^3.0.1",
    "postcss": "^8.4.17",
    "tailwindcss": "^3.1.8",
    "typescript": "^5.9.3",
    "vite": "^3.2.7",
    "vue": "^3.2.37",
    "vue-router": "4",
    "vue-tsc": "^3.2.6"
  },
  "dependencies": {
    "@vueuse/core": "^9.3.0",
    "electrobun": "^1.16.0",
    "uuid": "^9.0.0"
  }
}
